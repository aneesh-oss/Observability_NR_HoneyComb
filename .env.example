# OpenTelemetry & Telemetry Cloud Destinations Configuration

# Service Name
OTEL_SERVICE_NAME=todo-backend-service

# Honeycomb Config
# Get API key from https://ui.honeycomb.io/ -> Settings -> Environment Keys
HONEYCOMB_API_KEY=your_honeycomb_api_key_here
HONEYCOMB_DATASET=todo-app-traces

# New Relic Config
# Get Ingest / License Key from https://one.newrelic.com/ -> API Keys -> License Key
NEW_RELIC_LICENSE_KEY=your_newrelic_license_key_here
